# ── Core Database & Security ──────────────────────────────────────────────────
# Production PostgreSQL (Render / Neon / Supabase) or SQLite: sqlite:///./mini_siem.db
DATABASE_URL=postgresql+psycopg://siem:siem@localhost:5432/mini_siem
JWT_SECRET_KEY=change-this-to-a-very-long-random-string-in-production
JWT_EXPIRE_MINUTES=720
AUTO_CREATE_TABLES=true

# ── CORS Settings ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins or * for open CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://mini-siem-dashboard.vercel.app

# ── Juice Shop Live Telemetry Connector ───────────────────────────────────────
# Set to true to ingest real-time attack telemetry from victim Juice Shop app
ENABLE_JUICE_SHOP_CONNECTOR=false
JUICE_SHOP_TELEMETRY_URL=https://demo-victim-1.onrender.com/api/telemetry/events
JUICE_SHOP_TELEMETRY_API_KEY=
POLL_INTERVAL_SECONDS=10.0
BATCH_SIZE=50

# ── Frontend Configuration ────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api
